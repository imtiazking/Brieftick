{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["lhr1"],
  "functions": {
    "app/design-lab/regulatory-intelligence/**": {
      "includeFiles": "design-lab-bundle/regulatory-intelligence/**"
    }
  },
  "crons": [
    {
      "path": "/api/internal/ri-ingestion/scheduler-tick",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/ri-ingestion/scheduler-tick",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/internal/ri-ingestion/scheduler-tick",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/internal/ri-ingestion/scheduler-tick",
      "schedule": "0 20 * * *"
    }
  ]
}
