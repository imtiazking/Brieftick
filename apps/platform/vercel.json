{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["lhr1"],
  "crons": [
    { "path": "/api/internal/ri-ingestion/scheduler-tick", "schedule": "0 0 * * *" },
    { "path": "/api/internal/ri-ingestion/scheduler-tick", "schedule": "0 4 * * *" },
    { "path": "/api/internal/ri-ingestion/scheduler-tick", "schedule": "0 12 * * *" },
    { "path": "/api/internal/ri-ingestion/scheduler-tick", "schedule": "0 20 * * *" }
  ],
  "functions": {
    "app/api/internal/ri-ingestion/scheduler-tick/route.ts": {
      "maxDuration": 300,
      "includeFiles": "../../../../../../../integrations/regulatory-sources/certs/**,../../../../../../../integrations/regulatory-sources/core/**,../../../../../../../integrations/regulatory-sources/connectors/**"
    },
    "app/api/ri-lab/ai-analysis-runs/route.ts": {
      "maxDuration": 300
    },
    "app/design-lab/regulatory-intelligence/**": {
      "includeFiles": "design-lab-bundle/regulatory-intelligence/**"
    }
  }
}
