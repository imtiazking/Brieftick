# FORGENIQ Platform — environment contract (names only; never commit real values)

# Application
FORGENIQ_ENV=development
# FORGENIQ_BUILD_ID is set at build time (e.g. Vercel git SHA)

# Clerk (single identity provider — no Supabase Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Production Clerk secret for hosted staging UAT (sk_live_* — matches pk_live on staging-app.forgeniq.com). Never commit.
FORGENIQ_HOSTED_CLERK_SECRET_KEY=
# Default Playwright storage: %LOCALAPPDATA%\\ForgenIQ\\uat\\hosted-user-a-storage.json (see phase85l-capture-hosted-session)
FORGENIQ_PLAYWRIGHT_STORAGE_STATE=
# FORGENIQ_UAT_USER_A_EMAIL=
# FORGENIQ_UAT_USER_A_PASSWORD=
# FORGENIQ_UAT_USER_B_EMAIL=
# FORGENIQ_UAT_USER_B_PASSWORD=
# Production checker on staging-app (Clerk production). Do not use dev checker user_3DxiRjBTbsVio94Zh9jraCdwWr8.
# FORGENIQ_UAT_83H_USER_CHECKER=user_3Fa9TcFi8izkxHdDP58Qb3UY4mr
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/design-lab/regulatory-intelligence/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/design-lab/regulatory-intelligence/

# Supabase — target production region: London (eu-west-2) when provisioned
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Staging technical AI tenant (FORGENIQ AI Development — experimental AI only; not Partner UAT or Org A live probes)
# STAGING_AI_TECH_ORG_ID=b8f5e3a1-00ad-4000-8000-000000000001

# Clerk → Supabase third-party auth (dashboard integration; do NOT use deprecated JWT templates)
# Configure Clerk as third-party JWT provider in Supabase; server sends Clerk session token to Supabase.
