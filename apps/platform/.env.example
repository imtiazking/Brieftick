# FORGENIQ Platform — environment contract (names only; never commit real values)

# Application
FORGENIQ_ENV=development
# FORGENIQ_BUILD_ID is set at build time (e.g. Vercel git SHA)

# Clerk (single identity provider — no Supabase Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# Supabase — target production region: London (eu-west-2) when provisioned
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Future: Clerk third-party JWT for Supabase RLS (configure in Clerk + Supabase dashboards)
# CLERK_JWT_ISSUER=
