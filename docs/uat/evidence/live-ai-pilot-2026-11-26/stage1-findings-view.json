    "findings": [
      {
        "findingId": "49f7a26a-419a-4f86-b0ec-f7afad087706",
        "number": 1,
        "claimIndex": 0,
        "statement": "CONC 7.20.1R (proposed) would require a firm, as soon as possible after a borrower's missed payment under a regulated deferred payment credit agreement, to notify the borrower of the missed payment and of unpaid sums, and to provide information on the agreement concerned and the adverse consequences and mitigation steps, all together. This is a consultation proposal, not a binding obligation.",
